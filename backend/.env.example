# Copy to .env and fill in. Never commit .env.
# AI provider for explanations and the assistant. Groq is free with no credit card: console.groq.com/keys
GROQ_API_KEY=
# Optional alternatives (the first key found is used, or force one with LLM_PROVIDER=groq|gemini|openrouter|openai|ollama)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=
# Optional: force a specific model name
LLM_MODEL=
LLM_TIMEOUT_S=15
